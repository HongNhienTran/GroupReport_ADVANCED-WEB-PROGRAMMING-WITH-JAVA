# ==============================================================================
# The Sweet Lab - Environment Configuration Template
# Hướng dẫn: Sao chép file này thành .env và điền thông số thực tế của bạn
# LƯU Ý: KHÔNG commit file .env chứa thông tin bí mật lên Git!
# ==============================================================================

# Server Port
SERVER_PORT=

# PostgreSQL Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Mail Server Configuration (Mailpit cho local dev, hoặc SMTP Gmail/SendGrid)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_VERIFICATION_URL=
MAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=

# JWT Secret & Token Expiration
# JWT_SECRET: Chuỗi bí mật Base64 hoặc Hex tối thiểu 256 bits (32 bytes)
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=
JWT_REFRESH_TOKEN_EXPIRATION_MS=

# CORS Configuration (Các origin được phép, phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=

# Google Gemini AI API Key (Phục vụ module AI Nutrition & Chatbot)
GEMINI_API_KEY=
