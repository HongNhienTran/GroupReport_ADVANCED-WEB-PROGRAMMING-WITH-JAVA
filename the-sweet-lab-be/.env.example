# ==============================================================================
# The Sweet Lab - Backend Environment Configuration Template (.env.example)
# Hãy sao chép file này thành .env và điền thông tin thực tế của bạn
# ==============================================================================

# 1. Server Port
SERVER_PORT=8080

# 2. PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# 3. Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 4. Real Email Configuration (Brevo SMTP - Free 300 emails/day)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email@gmail.com
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_VERIFICATION_URL=http://localhost:3000/verify-email
MAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=15

# 5. Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 6. JWT Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=
JWT_REFRESH_TOKEN_EXPIRATION_MS=

# 7. CORS Configuration
CORS_ALLOWED_ORIGINS=

# 8. Google Gemini AI Key
GEMINI_API_KEY=
